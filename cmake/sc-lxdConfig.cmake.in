@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SimplyCppFunctions.cmake")
include(CMakeFindDependencyMacro)

# nlohmann/json comes with sc-core.
find_or_install_package(sc-core simply-cpp-dev simply-cpp 4.0.0)
# sc::http::client (rest.h), sc-core's until 2.0.0.
find_or_install_package(sc-http simply-cpp-http-dev simply-cpp-http 4.0.0)

include("${CMAKE_CURRENT_LIST_DIR}/sc-lxdTargets.cmake")
